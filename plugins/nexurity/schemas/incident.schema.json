{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nexurity/incident.schema.json",
  "title": "Nexurity incident report (incident.json)",
  "description": "Input of render_report.py for an incident report. The exposure window and the 72-hour deadline are computed.",
  "type": "object",
  "required": [
    "ref",
    "target_name",
    "status"
  ],
  "properties": {
    "ref": {
      "type": "string",
      "pattern": "^[A-Z]{2,5}-\\d{4}-\\d{3,}$"
    },
    "language": {
      "enum": [
        "en",
        "fr"
      ]
    },
    "target_name": {
      "type": "string"
    },
    "context": {
      "type": "string"
    },
    "period": {
      "type": "object",
      "properties": {
        "start": {
          "type": "string"
        },
        "end": {
          "type": "string"
        }
      }
    },
    "report_version": {
      "type": "string"
    },
    "report_date": {
      "type": "string"
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          }
        }
      }
    },
    "status": {
      "enum": [
        "confirmed",
        "suspected",
        "not-confirmed"
      ]
    },
    "severity": {
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "info"
      ]
    },
    "dates": {
      "type": "object",
      "properties": {
        "start": {
          "type": "string",
          "description": "ISO 8601, yyyy-mm-ddThh:mm (with offset when known)"
        },
        "detection": {
          "type": "string",
          "description": "ISO 8601, yyyy-mm-ddThh:mm (with offset when known)"
        },
        "containment": {
          "type": "string",
          "description": "ISO 8601, yyyy-mm-ddThh:mm (with offset when known)"
        }
      }
    },
    "summary": {
      "type": "string"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "not_observed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "immediate_actions": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "properties": {
          "severity": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "info"
            ]
          },
          "action": {
            "type": "string"
          }
        }
      }
    },
    "symptoms": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "affected_system": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "period": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          }
        }
      }
    },
    "limitations": {
      "type": "string"
    },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "date",
          "phase",
          "event"
        ],
        "properties": {
          "date": {
            "type": "string",
            "description": "ISO 8601, yyyy-mm-ddThh:mm (with offset when known)"
          },
          "phase": {
            "enum": [
              "recon",
              "intrusion",
              "persistence",
              "action",
              "detection",
              "response"
            ]
          },
          "event": {
            "type": "string"
          },
          "details": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        }
      }
    },
    "timezone": {
      "type": "string"
    },
    "timezone_note": {
      "type": "string"
    },
    "entry_point": {
      "type": "object",
      "properties": {
        "vector": {
          "type": "string"
        },
        "component": {
          "type": "string"
        },
        "confidence": {
          "enum": [
            "established",
            "likely",
            "hypothesis"
          ]
        },
        "finding": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "log_extract": {
          "type": "string"
        },
        "ruled_out": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "iocs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "value"
        ],
        "properties": {
          "kind": {
            "enum": [
              "ip",
              "file",
              "cron",
              "account",
              "domain",
              "url",
              "hash",
              "other"
            ]
          },
          "type": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "first_seen": {
            "type": "string"
          },
          "action": {
            "type": "string"
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "status"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "area": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "component": {
            "type": "string"
          },
          "location": {
            "type": "object",
            "properties": {
              "file": {
                "type": "string"
              },
              "line": {
                "type": "integer"
              }
            }
          },
          "cvss_vector": {
            "type": "string",
            "pattern": "^CVSS:4\\.0/"
          },
          "cvss_justification": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "cvss_score": {
            "type": "number",
            "description": "Optional. Must equal the score computed from cvss_vector, or the report is refused."
          },
          "status": {
            "enum": [
              "Open",
              "To confirm",
              "Fixed"
            ]
          },
          "business_adjustment": {
            "type": "object",
            "required": [
              "severity",
              "justification"
            ],
            "properties": {
              "severity": {
                "enum": [
                  "critical",
                  "high",
                  "medium",
                  "low",
                  "info"
                ]
              },
              "justification": {
                "type": "string"
              }
            }
          },
          "description": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "code"
              ],
              "properties": {
                "label": {
                  "type": "string"
                },
                "language": {
                  "type": "string"
                },
                "code": {
                  "type": "string"
                },
                "defang": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          },
          "impact": {
            "type": "string"
          },
          "recommendations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "recommendation_code": {
            "type": "object",
            "properties": {
              "language": {
                "type": "string"
              },
              "code": {
                "type": "string"
              }
            }
          },
          "table": {
            "type": "object",
            "properties": {
              "headers": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "rows": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "references": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "remediation": {
      "type": "object",
      "properties": {
        "containment": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "action"
            ],
            "properties": {
              "ref": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "action": {
                "type": "string"
              }
            }
          }
        },
        "eradication": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "action"
            ],
            "properties": {
              "ref": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "action": {
                "type": "string"
              }
            }
          }
        },
        "hardening": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "action"
            ],
            "properties": {
              "ref": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "action": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "personal_data": {
      "type": "object",
      "properties": {
        "exposed": {
          "type": "string"
        },
        "people": {
          "type": "string"
        },
        "awareness": {
          "type": "string",
          "description": "ISO 8601, yyyy-mm-ddThh:mm (with offset when known)"
        },
        "controller": {
          "type": "string"
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "category": {
                "type": "string"
              },
              "exposure": {
                "type": "string"
              },
              "rationale": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
