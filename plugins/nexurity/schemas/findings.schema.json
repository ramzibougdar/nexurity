{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nexurity/findings.schema.json",
  "title": "Nexurity audit findings (findings.json)",
  "description": "Input of render_report.py for an audit report. Scores and counters are computed, never stored.",
  "type": "object",
  "required": [
    "ref",
    "client",
    "target_name",
    "findings"
  ],
  "properties": {
    "ref": {
      "type": "string",
      "pattern": "^[A-Z]{2,5}-\\d{4}-\\d{3,}$"
    },
    "language": {
      "enum": [
        "en",
        "fr"
      ]
    },
    "client": {
      "type": "string"
    },
    "target_name": {
      "type": "string"
    },
    "context": {
      "type": "string"
    },
    "period": {
      "type": "object",
      "properties": {
        "start": {
          "type": "string"
        },
        "end": {
          "type": "string"
        }
      }
    },
    "report_version": {
      "type": "string"
    },
    "report_date": {
      "type": "string"
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          }
        }
      }
    },
    "summary": {
      "type": "string"
    },
    "priorities": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "properties": {
          "severity": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "info"
            ]
          },
          "action": {
            "type": "string"
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "properties": {
        "targets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "target": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "environment": {
                "type": "string"
              },
              "version": {
                "type": "string"
              }
            }
          }
        },
        "in_scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "out_of_scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "local_environment": {
      "type": "boolean"
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "status"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "area": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "component": {
            "type": "string"
          },
          "location": {
            "type": "object",
            "properties": {
              "file": {
                "type": "string"
              },
              "line": {
                "type": "integer"
              }
            }
          },
          "cvss_vector": {
            "type": "string",
            "pattern": "^CVSS:4\\.0/"
          },
          "cvss_justification": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "cvss_score": {
            "type": "number",
            "description": "Optional. Must equal the score computed from cvss_vector, or the report is refused."
          },
          "status": {
            "enum": [
              "Open",
              "To confirm",
              "Fixed"
            ]
          },
          "business_adjustment": {
            "type": "object",
            "required": [
              "severity",
              "justification"
            ],
            "properties": {
              "severity": {
                "enum": [
                  "critical",
                  "high",
                  "medium",
                  "low",
                  "info"
                ]
              },
              "justification": {
                "type": "string"
              }
            }
          },
          "description": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "code"
              ],
              "properties": {
                "label": {
                  "type": "string"
                },
                "language": {
                  "type": "string"
                },
                "code": {
                  "type": "string"
                },
                "defang": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          },
          "impact": {
            "type": "string"
          },
          "recommendations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "recommendation_code": {
            "type": "object",
            "properties": {
              "language": {
                "type": "string"
              },
              "code": {
                "type": "string"
              }
            }
          },
          "table": {
            "type": "object",
            "properties": {
              "headers": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "rows": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "references": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "action_plan": {
      "type": "object",
      "properties": {
        "immediate": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "action"
            ],
            "properties": {
              "ref": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "action": {
                "type": "string"
              }
            }
          }
        },
        "short_term": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "action"
            ],
            "properties": {
              "ref": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "action": {
                "type": "string"
              }
            }
          }
        },
        "medium_term": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "action"
            ],
            "properties": {
              "ref": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "action": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
